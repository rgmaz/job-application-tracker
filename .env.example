# Copy to .env and adjust for your deployment. Secrets go in .env, never
# in the image or in git.

# Address the HTTP server listens on. Use 127.0.0.1 when a local TLS proxy
# fronts the app; 0.0.0.0 only when the container is exposed directly.
BIND_ADDR=127.0.0.1
PORT=8080

# Single backup unit inside the container; mounted from the host in compose.
DATA_DIR=/data

# Public base URL. Sets COOKIE_SECURE automatically when https; override
# COOKIE_SECURE=true behind a TLS-terminating proxy.
BASE_URL=http://localhost:8080

# Default location: Harare (UTC+2, no DST). Calendar-day fields are stored
# as local dates.
TZ=Africa/Harare

# Auth is on by default. Set AUTH_DISABLED=true only behind a trusted
# reverse proxy, together with TRUST_PROXY_AUTH=true.
AUTH_DISABLED=false
TRUST_PROXY_AUTH=false
COOKIE_SECURE=

# Upload cap per file in MiB.
MAX_UPLOAD_MB=25

# Session cookie lifetime in hours.
SESSION_TTL_HOURS=720
